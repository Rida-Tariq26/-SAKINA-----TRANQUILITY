# =================================================================
# SAKINA ENVIRONMENT CONFIGURATION
# =================================================================

# 1. Google Gemini API Key (Server fallback)
# Optional if users supply their own key (BYOK) in browser settings.
GOOGLE_API_KEY=your_google_gemini_api_key_here

# 2. Google Gemini Model Selection
# Primary conversational agent: gemini-2.5-flash (Supported free-tier: gemini-2.5-flash, gemini-3.5-flash-lite, gemini-3.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Auxiliary lightweight tasks (guardrails judge, emotion resolution, farewell, mood synthesis): gemini-3.5-flash-lite
GEMINI_AUXILIARY_MODEL=gemini-3.5-flash-lite

# 3. Google OAuth 2.0 Client ID (For Google Sign-In)
# Optional if running in guest/unauthenticated mode.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# 4. Supabase Cloud Database (Required for persistent production storage)
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Recommended for backend services: service_role key (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Alternative fallback: anon public key
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# 5. Cryptographic Security & Privacy Keys
# Used to sign session JWTs (generate with: openssl rand -hex 32)
SAKINA_SESSION_SECRET=generate_a_random_32_byte_hex_secret_here
# Used for AES-Fernet encryption of sensitive journal & mood entries (optional, auto-derived if omitted)
SAKINA_ENCRYPTION_KEY=
# Salt for privacy-preserving feedback IP hashing (generate with: openssl rand -hex 16)
FEEDBACK_IP_SALT=generate_a_random_salt_here
# Secret key for administrative feedback review moderation (/api/admin/feedback)
SAKINA_ADMIN_KEY=your_secret_admin_moderation_key_here

# 6. Server Port (Default: 8000)
PORT=8000
