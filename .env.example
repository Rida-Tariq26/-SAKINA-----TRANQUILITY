# =================================================================
# SAKINA ENVIRONMENT CONFIGURATION
# =================================================================

# 1. Google Gemini API Key (Server fallback)
# Optional if users supply their own key (BYOK) in browser settings.
GOOGLE_API_KEY=your_google_gemini_api_key_here

# 2. Google Gemini Model Selection
# Default: gemini-2.5-flash (Supported: gemini-2.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# 3. Google OAuth 2.0 Client ID (For Google Sign-In)
# Optional if running in guest/unauthenticated mode.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# 4. Server Port (Default: 8000)
PORT=8000
